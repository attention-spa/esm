{
    "compilerOptions": {
        "module": "nodenext",
        "target": "ESNext",
        "sourceMap": true,
        "skipDefaultLibCheck": true,
        "skipLibCheck": true,
        /**
    "lib": [
      "WebWorker",
      "ESNext"
    ],
    */
        "tsBuildInfoFile": ".build/tsbuildinfo",
        "moduleResolution": "nodenext",
        "allowImportingTsExtensions": true,
        "moduleDetection": "auto",
        "incremental": true,
        "esModuleInterop": true,
        "emitDeclarationOnly": true,
        "composite": true,
        "strict": true,
        "resolveJsonModule": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "baseUrl": ".",
        "removeComments": false,
        "noEmitHelpers": false,
        "paths": {
            "@/*": [
                "src/*"
            ]
        }
    },
    "typeAcquisition": {
        "enable": true,
    },
    "include": [
        "src"
    ],
    "exclude": [
        "node_modules",
        "scripts"
    ],
    "ts-node": {
        "esm": true
    }
}